      "name": "01 Empresa",
      "item": [
        {
          "name": "1. Registrar empresa (201)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"ruc\", String(Math.floor(10000000000 + Math.random() * 89999999999)));",
                  "pm.collectionVariables.set(\"hoy\", new Date().toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"empresaId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
